{
  "name": "mydraw",
  "version": "0.1.0",
  "description": "Local Excalidraw desktop app with stencils and Claude Code control",
  "private": true,
  "type": "module",
  "main": "app/dist/main.cjs",
  "bin": {
    "mydraw": "bin/mydraw.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-app.mjs && node scripts/build-mcp.mjs && vite build",
    "start": "npm run build && node scripts/start.mjs",
    "icon": "node scripts/make-icon.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "link-cli": "npm link"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "elkjs": "^0.11.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
