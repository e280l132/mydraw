{
  "name": "mydraw",
  "version": "0.2.0",
  "description": "Local Excalidraw desktop app with stencils and Claude Code control",
  "private": true,
  "type": "module",
  "main": "app/dist/boot.cjs",
  "bin": {
    "mydraw": "bin/mydraw.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-app.mjs && node scripts/build-mcp.mjs && vite build",
    "start": "npm run build && node scripts/start.mjs",
    "icon": "node scripts/make-icon.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "link-cli": "npm link",
    "package": "npm run build && electron-builder --mac --arm64 --publish never",
    "install-app": "node scripts/install-app.mjs",
    "dmg-background": "\"$(node scripts/electron-app.mjs | tail -1)\" scripts/dmg-background.cjs",
    "verify-package": "node scripts/verify-package.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/gochi-hand": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/indie-flower": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "elkjs": "^0.11.1",
    "esbuild": "^0.28.2",
    "path-data-parser": "0.1.0",
    "playwright-core": "^1.65.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "roughjs": "4.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
